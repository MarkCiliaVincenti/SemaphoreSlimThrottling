<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Exe</OutputType>
		<IsTestProject>true</IsTestProject>
		<IsPackable>false</IsPackable>
		<AssemblyOriginatorKeyFile>SemaphoreSlimThrottling.snk</AssemblyOriginatorKeyFile>
		<NoWarn>xUnit1051</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" />

		<!-- Required when dotnet test uses Microsoft Testing Platform -->
		<PackageReference Include="xunit.v3.mtp-v2" />

		<!-- Microsoft Testing Platform code coverage extension (replaces coverlet/VSTest collector) -->
		<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
	</ItemGroup>

	<ItemGroup>
		<None Update="xunit.runner.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SemaphoreSlimThrottling\SemaphoreSlimThrottling.csproj" />
	</ItemGroup>

</Project>
